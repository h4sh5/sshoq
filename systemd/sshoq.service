# SSHOQ server example systemd service file

[Unit]
Description=SSH over QUIC server
After=network.target auditd.service

[Service]
# use -generate-public-cert example.com instead if you want to auto generate valid public certificate via LetsEncrypt
# change the -url-path so that it's unique to your server for security
ExecStart=/usr/sbin/sshoq-server -generate-selfsigned-cert -url-path /my-sshoq-server
KillMode=process
Restart=on-failure
Type=simple
RuntimeDirectory=sshoq
# 0700, not 0755: whatever lands in there (a socket, a token) belongs to the server alone,
# and there is no reason for the rest of the box to be able to list it
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
Alias=sshoq.service
